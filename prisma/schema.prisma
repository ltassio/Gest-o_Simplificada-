// =============================================================================
// Gestão Simples — Prisma Schema
// Espelha exatamente as tabelas criadas pela migration 001_schema_inicial.sql
// no Supabase. Não roda "prisma migrate" aqui: as tabelas já existem, este
// schema serve para o Prisma Client conseguir ler/escrever nelas com
// segurança de tipos.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(uuid()) @db.Uuid
  nome      String
  createdAt DateTime @default(now()) @map("created_at")

  perfis                 Perfil[]
  clientes               Cliente[]
  profissionais          Profissional[]
  servicos               Servico[]
  parametrosPrecificacao ParametroPrecificacao?
  agendamentos           Agendamento[]
  atendimentos           Atendimento[]
  fornecedores           Fornecedor[]
  contasPagar            ContaPagar[]
  contasReceber          ContaReceber[]
  formasPagamento        FormaPagamento[]
  planoContas            PlanoConta[]
  contasBancarias        ContaBancaria[]

  @@map("tenants")
}

// Papel do usuário dentro do tenant (Documento de Modelagem de Banco de
// Dados v1.2, módulo Financeiro Fase 1): controla acesso ao módulo
// Financeiro. "dono" = acesso total + gerencia usuários; "financeiro" =
// acesso total ao Financeiro, não gerencia usuários; "operador" = não
// enxerga o Financeiro (Contas a Pagar/Receber, Fornecedores, Plano de
// Contas, Formas de Pagamento, DRE, Orçamento), só Agenda/Clientes/
// Serviços/Caixa. Reforçado via RLS (papel_atual()), não só na UI.
// Valores possíveis (checados no banco, não aqui): "dono" | "financeiro" | "operador".

model Perfil {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String?
  email     String?
  papel     String   @default("dono")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("perfis")
}

model Cliente {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  nome        String
  telefone    String?
  email       String?
  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  agendamentos  Agendamento[]
  atendimentos  Atendimento[]
  contasReceber ContaReceber[]

  @@map("clientes")
}

model Profissional {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  nome               String
  percentualComissao Decimal  @default(0) @map("percentual_comissao") @db.Decimal(5, 2)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  agendamentos Agendamento[]
  atendimentos Atendimento[]

  @@map("profissionais")
}

model Servico {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  nome           String
  duracaoMinutos Int      @map("duracao_minutos")
  custoMaterial  Decimal  @default(0) @map("custo_material") @db.Decimal(10, 2)
  preco          Decimal  @default(0) @db.Decimal(10, 2)
  categoria      String?
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  agendamentos Agendamento[]
  atendimentos Atendimento[]

  @@map("servicos")
}

model ParametroPrecificacao {
  id                       String   @id @default(uuid()) @db.Uuid
  tenantId                 String   @unique @map("tenant_id") @db.Uuid
  custoFixoMensal          Decimal  @default(0) @map("custo_fixo_mensal") @db.Decimal(10, 2)
  horasProdutivasMes       Decimal  @default(0) @map("horas_produtivas_mes") @db.Decimal(6, 2)
  percentualImposto        Decimal  @default(0) @map("percentual_imposto") @db.Decimal(5, 2)
  percentualMargemDesejada Decimal  @default(0) @map("percentual_margem_desejada") @db.Decimal(5, 2)
  updatedAt                DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("parametros_precificacao")
}

model Agendamento {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  clienteId        String   @map("cliente_id") @db.Uuid
  profissionalId   String   @map("profissional_id") @db.Uuid
  servicoId        String   @map("servico_id") @db.Uuid
  dataHoraInicio   DateTime @map("data_hora_inicio")
  dataHoraFim      DateTime @map("data_hora_fim")
  status           String   @default("agendado")
  createdAt        DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  servico      Servico      @relation(fields: [servicoId], references: [id])
  atendimento  Atendimento?

  @@map("agendamentos")
}

model Atendimento {
  id                          String   @id @default(uuid()) @db.Uuid
  tenantId                    String   @map("tenant_id") @db.Uuid
  agendamentoId               String?  @unique @map("agendamento_id") @db.Uuid
  clienteId                   String   @map("cliente_id") @db.Uuid
  profissionalId              String   @map("profissional_id") @db.Uuid
  servicoId                   String   @map("servico_id") @db.Uuid
  valorCobrado                Decimal  @map("valor_cobrado") @db.Decimal(10, 2)
  percentualComissaoAplicado  Decimal  @map("percentual_comissao_aplicado") @db.Decimal(5, 2)
  valorComissao               Decimal  @map("valor_comissao") @db.Decimal(10, 2)
  valorEstudio                Decimal  @map("valor_estudio") @db.Decimal(10, 2)
  dataAtendimento              DateTime @default(now()) @map("data_atendimento")
  createdAt                   DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  agendamento  Agendamento? @relation(fields: [agendamentoId], references: [id])
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  profissional Profissional @relation(fields: [profissionalId], references: [id])
  servico      Servico      @relation(fields: [servicoId], references: [id])

  @@map("atendimentos")
}

// =============================================================================
// Contas a Pagar / Contas a Receber — módulo financeiro adicionado em
// 30/07/2026 (Documento de Modelagem de Banco de Dados v1.1).
// Contas a Receber é separado do Caixa/Atendimentos: o Caixa assume
// recebimento na hora; Contas a Receber é para dinheiro que ainda vai
// entrar (fiado, parcelado, boleto). "Vencida" nunca é gravado como status —
// é sempre derivado (status ainda aberto + data_vencimento no passado).
// =============================================================================

model Fornecedor {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  nome        String
  telefone    String?
  email       String?
  cnpj        String?
  observacoes String?
  createdAt   DateTime @default(now()) @map("created_at")

  tenant      Tenant       @relation(fields: [tenantId], references: [id])
  contasPagar ContaPagar[]

  @@map("fornecedores")
}

model ContaPagar {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  fornecedorId     String    @map("fornecedor_id") @db.Uuid
  descricao        String
  valor            Decimal   @db.Decimal(10, 2)
  dataVencimento   DateTime  @map("data_vencimento") @db.Date
  dataPagamento    DateTime? @map("data_pagamento") @db.Date
  status           String    @default("a_pagar")
  planoContaId     String?   @map("plano_conta_id") @db.Uuid
  formaPagamentoId String?   @map("forma_pagamento_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  fornecedor     Fornecedor      @relation(fields: [fornecedorId], references: [id])
  planoConta     PlanoConta?     @relation(fields: [planoContaId], references: [id])
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  @@map("contas_pagar")
}

model ContaReceber {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @map("tenant_id") @db.Uuid
  clienteId        String    @map("cliente_id") @db.Uuid
  descricao        String
  valor            Decimal   @db.Decimal(10, 2)
  dataVencimento   DateTime  @map("data_vencimento") @db.Date
  dataRecebimento  DateTime? @map("data_recebimento") @db.Date
  status           String    @default("a_receber")
  planoContaId     String?   @map("plano_conta_id") @db.Uuid
  formaPagamentoId String?   @map("forma_pagamento_id") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at")

  tenant         Tenant          @relation(fields: [tenantId], references: [id])
  cliente        Cliente         @relation(fields: [clienteId], references: [id])
  planoConta     PlanoConta?     @relation(fields: [planoContaId], references: [id])
  formaPagamento FormaPagamento? @relation(fields: [formaPagamentoId], references: [id])

  @@map("contas_receber")
}

// =============================================================================
// Financeiro (Fase 1) — Formas de Pagamento e Plano de Contas.
// Adicionado em 30/07/2026 (Documento de Modelagem de Banco de Dados v1.2).
// =============================================================================

model FormaPagamento {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  nome      String
  ativa     Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]

  @@map("formas_pagamento")
}

// natureza_dre classifica cada conta na linha correta da DRE (Fase 3):
// receita_servicos, deducoes, custo_servicos, despesa_operacional,
// despesa_financeira, receita_financeira, outras_receitas, outras_despesas.
model PlanoConta {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  nome         String
  tipo         String
  naturezaDre  String   @map("natureza_dre")
  contaPaiId   String?  @map("conta_pai_id") @db.Uuid
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  contaPai      PlanoConta?    @relation("PlanoContaHierarquia", fields: [contaPaiId], references: [id])
  subcontas     PlanoConta[]   @relation("PlanoContaHierarquia")
  contasPagar   ContaPagar[]
  contasReceber ContaReceber[]

  @@map("plano_contas")
}

// =============================================================================
// Contas Bancárias — cadastro de contas de banco para controle de saldo,
// adicionado em 30/07/2026 a pedido do usuário. Separado de Contas a Pagar/
// Receber (que controlam o que ainda vai sair/entrar) e do Caixa (caixa
// físico do dia a dia, Fase 2). Nesta primeira versão, saldo_atual é
// atualizado manualmente pelo usuário (ex.: ao conferir o extrato) — não
// há conciliação automática com lançamentos ainda.
model ContaBancaria {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  nome          String
  banco         String?
  agencia       String?
  numeroConta   String?  @map("numero_conta")
  tipo          String   @default("corrente")
  saldoInicial  Decimal  @default(0) @map("saldo_inicial") @db.Decimal(12, 2)
  saldoAtual    Decimal  @default(0) @map("saldo_atual") @db.Decimal(12, 2)
  ativa         Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("contas_bancarias")
}
