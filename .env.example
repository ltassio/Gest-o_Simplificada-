# =============================================================================
# Variáveis de ambiente — Gestão Simples (API Routes)
# Copie este arquivo para ".env" (rodar local) ou configure no painel da
# Vercel (Settings > Environment Variables) para o deploy.
# =============================================================================

# Connection string do Supabase COM pooler (pgbouncer) — usada em runtime
# normal pelas API Routes. Pegue em: Project Settings > Database > Connection
# string > "Transaction" mode.
DATABASE_URL="postgresql://postgres:[SUA-SENHA]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"

# Connection string DIRETA (sem pooler) — usada só pelo Prisma para rodar
# migrations. Pegue em: Project Settings > Database > Connection string >
# "Session" mode.
DIRECT_URL="postgresql://postgres:[SUA-SENHA]@db.[PROJECT-REF].supabase.co:5432/postgres"

# URL do projeto e Secret Key do Supabase — usados para validar o login do
# usuário nas API Routes (chamando o próprio servidor de autenticação do
# Supabase, em vez de guardar um segredo de assinatura localmente).
# Pegue em: Project Settings > API Keys.
#   SUPABASE_URL        = "Project URL" (ex: https://SEUPROJETO.supabase.co)
#   SUPABASE_SECRET_KEY  = a "secret key" (começa com "sb_secret_..."), ou a
#                          "service_role key" se seu projeto ainda usa o
#                          formato antigo de chaves.
SUPABASE_URL="https://SEUPROJETO.supabase.co"
SUPABASE_SECRET_KEY="cole-aqui-a-secret-key"
